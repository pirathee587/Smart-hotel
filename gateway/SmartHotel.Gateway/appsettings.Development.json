{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "Authentication": {
    "Issuer": "SmartHotel.Identity",
    "Audience": "SmartHotel.Clients",
    "JwksUri": "http://localhost:5001/.well-known/jwks.json"
  },
  "DownstreamServices": {
    "IdentityService": "http://localhost:5001",
    "HotelOpsService": "http://localhost:5002",
    "BookingService": "http://localhost:5003",
    "FieldOpsService": "http://localhost:8084",
    "NotificationService": "http://localhost:5004",
    "ConciergeService": "http://localhost:5005"
  },
  "ReverseProxy": {
    "Clusters": {
      "identity-service": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "hotelops-service": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5002"
          }
        }
      },
      "booking-service": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5003"
          }
        }
      },
      "fieldops-service": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:8084"
          }
        }
      },
      "notifications-service": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5004"
          }
        }
      },
      "concierge-service": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5005"
          }
        }
      }
    }
  }
}
