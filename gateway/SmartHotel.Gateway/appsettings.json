{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Issuer": "SmartHotel.Identity",
    "Audience": "SmartHotel.Clients",
    "JwksUri": "http://identity-service:5001/.well-known/jwks.json"
  },
  "RateLimiting": {
    "Customer": {
      "TokenLimit": 60,
      "TokensPerPeriod": 60,
      "ReplenishmentPeriodSeconds": 60,
      "QueueLimit": 0
    },
    "Employee": {
      "TokenLimit": 120,
      "TokensPerPeriod": 120,
      "ReplenishmentPeriodSeconds": 60,
      "QueueLimit": 0
    },
    "Admin": {
      "TokenLimit": 200,
      "TokensPerPeriod": 200,
      "ReplenishmentPeriodSeconds": 60,
      "QueueLimit": 0
    },
    "Anonymous": {
      "TokenLimit": 30,
      "TokensPerPeriod": 30,
      "ReplenishmentPeriodSeconds": 60,
      "QueueLimit": 0
    }
  },
  "DownstreamServices": {
    "IdentityService": "http://identity-service:5001",
    "HotelOpsService": "http://hotel-ops-service:5002",
    "BookingService": "http://booking-payments-service:5003",
    "FieldOpsService": "http://field-ops-service:8084",
    "NotificationService": "http://notification-service:5004",
    "ConciergeService": "http://concierge-service:5005"
  },
