# ==============================================================================
# SmartHotel Backend - Comprehensive Environment Variables Template
# ==============================================================================
# COPY THIS FILE TO '.env' AND FILL IN REAL VALUES FOR LOCAL OR DEPLOYED USE.
# DO NOT COMMIT THE ACTUAL '.env' FILE CONTAINING SECRETS TO VERSION CONTROL!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GLOBAL & COMMON SETTINGS
# ------------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
ENVIRONMENT=development
DOCKER_NETWORK=smarthotel-network
BASE_DOMAIN=localhost

# ------------------------------------------------------------------------------
# 2. INFRASTRUCTURE: POSTGRESQL (Multi-Database Setup)
# ------------------------------------------------------------------------------
# PostgreSQL Root/Admin (used by docker-compose and migration orchestrators)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERPASS=supersecret_postgres_password

# Identity Service Database (Local Docker or Supabase Cloud)
# For Supabase Cloud Shared Pooler:
SUPABASE_HOST=aws-0-ap-northeast-1.pooler.supabase.com
SUPABASE_PORT=5432
SUPABASE_DB=postgres
SUPABASE_USER=postgres.asynnvnpftudzhjjggjp
SUPABASE_PASSWORD=your_supabase_database_password_here

POSTGRES_IDENTITY_DB=smarthotel_identity_db
POSTGRES_IDENTITY_USER=identity_user
POSTGRES_IDENTITY_PASSWORD=identity_secure_password_123

# Hotel Operations Service Database
POSTGRES_HOTELOPS_DB=smarthotel_hotelops_db
POSTGRES_HOTELOPS_USER=hotelops_user
POSTGRES_HOTELOPS_PASSWORD=hotelops_secure_password_123

# Booking & Payments Service Database
POSTGRES_BOOKING_DB=smarthotel_booking_db
POSTGRES_BOOKING_USER=booking_user
POSTGRES_BOOKING_PASSWORD=booking_secure_password_123

# Field Operations Service Database (Java / Spring Boot)
POSTGRES_FIELDOPS_DB=smarthotel_fieldops_db
POSTGRES_FIELDOPS_USER=fieldops_user
POSTGRES_FIELDOPS_PASSWORD=fieldops_secure_password_123

# Notification Service Database
POSTGRES_NOTIFICATIONS_DB=smarthotel_notifications_db
POSTGRES_NOTIFICATIONS_USER=notifications_user
POSTGRES_NOTIFICATIONS_PASSWORD=notifications_secure_password_123

# ------------------------------------------------------------------------------
# 3. INFRASTRUCTURE: REDIS (Caching, Session, SignalR Backplane)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_password_123
REDIS_DEFAULT_DB=0
REDIS_SIGNALR_DB=1

# ------------------------------------------------------------------------------
# 4. INFRASTRUCTURE: RABBITMQ (Event-Driven Messaging)
# ------------------------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=smarthotel_rabbit
RABBITMQ_DEFAULT_PASS=rabbit_secure_password_123
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE_BOOKINGS=smarthotel.booking.events
RABBITMQ_EXCHANGE_TASKS=smarthotel.fieldops.tasks
RABBITMQ_EXCHANGE_NOTIFICATIONS=smarthotel.notifications.events

# ------------------------------------------------------------------------------
# 5. API GATEWAY (YARP - Reverse Proxy)
# ------------------------------------------------------------------------------
GATEWAY_HTTP_PORT=5000
GATEWAY_HTTPS_PORT=5001
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Gateway Downstream Service Routing Endpoints (Internal Docker / Local)
GATEWAY_IDENTITY_SERVICE_URL=http://identity-service:5001
GATEWAY_HOTELOPS_SERVICE_URL=http://hotel-ops-service:5002
GATEWAY_BOOKING_SERVICE_URL=http://booking-payments-service:5003
GATEWAY_FIELDOPS_SERVICE_URL=http://field-ops-service:8084
GATEWAY_NOTIFICATION_SERVICE_URL=http://notification-service:5005
GATEWAY_CONCIERGE_SERVICE_URL=http://ai-concierge-service:8000

# ------------------------------------------------------------------------------
# 6. SERVICE #1: IDENTITY SERVICE (.NET 8/9 Clean Architecture)
# ------------------------------------------------------------------------------
IDENTITY_HTTP_PORT=5001
IDENTITY_GRPC_PORT=6001
IDENTITY_DB_CONNECTION_STRING=Host=postgres;Port=5432;Database=smarthotel_identity_db;Username=identity_user;Password=identity_secure_password_123;Include Error Detail=true;

# JWT Authentication Config
JWT_SECRET_KEY=ReplaceWithAStrongSecretKeyOfAtLeast32BytesOr256BitsLengthHere!
JWT_ISSUER=SmartHotel.Identity
JWT_AUDIENCE=SmartHotel.Clients
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7

# Email Provider (Verification, Password Resets)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=no-reply@smarthotel.com
SMTP_ENABLE_SSL=true

# ------------------------------------------------------------------------------
# 7. SERVICE #2: HOTEL OPERATIONS SERVICE (.NET)
# ------------------------------------------------------------------------------
HOTELOPS_HTTP_PORT=5002
HOTELOPS_GRPC_PORT=6002
HOTELOPS_DB_CONNECTION_STRING=Host=postgres;Port=5432;Database=smarthotel_hotelops_db;Username=hotelops_user;Password=hotelops_secure_password_123;

# Storage / CDN for Room & Hotel Images (Local / S3 / Azure Blob)
HOTELOPS_STORAGE_PROVIDER=Local
HOTELOPS_STORAGE_LOCAL_PATH=./uploads/room-images
HOTELOPS_AWS_ACCESS_KEY_ID=your_aws_access_key
HOTELOPS_AWS_SECRET_ACCESS_KEY=your_aws_secret_key
HOTELOPS_AWS_REGION=us-east-1
HOTELOPS_AWS_S3_BUCKET_NAME=smarthotel-room-images

# ------------------------------------------------------------------------------
# 8. SERVICE #3: BOOKING & PAYMENTS SERVICE (.NET)
# ------------------------------------------------------------------------------
BOOKING_HTTP_PORT=5003
BOOKING_DB_CONNECTION_STRING=Host=postgres;Port=5432;Database=smarthotel_booking_db;Username=booking_user;Password=booking_secure_password_123;

# PayPal Payment Gateway Integration
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

# gRPC Clients (to verify Identity and Room availability in HotelOps)
IDENTITY_GRPC_TARGET_URL=http://identity-service:6001
HOTELOPS_GRPC_TARGET_URL=http://hotel-ops-service:6002

# ------------------------------------------------------------------------------
# 9. SERVICE #4: FIELD OPERATIONS SERVICE (Java 21 / Spring Boot)
# ------------------------------------------------------------------------------
FIELDOPS_SERVER_PORT=8084
FIELDOPS_GRPC_PORT=9084
FIELDOPS_DB_URL=jdbc:postgresql://postgres:5432/smarthotel_fieldops_db
FIELDOPS_DB_USERNAME=fieldops_user
FIELDOPS_DB_PASSWORD=fieldops_secure_password_123
FIELDOPS_JPA_HIBERNATE_DDL_AUTO=validate

# Weighted Allocation Algorithm Parameters
FIELDOPS_ALLOCATION_WEIGHT_SKILL=0.4
FIELDOPS_ALLOCATION_WEIGHT_PROXIMITY=0.3
FIELDOPS_ALLOCATION_WEIGHT_WORKLOAD=0.3

# ------------------------------------------------------------------------------
# 10. SERVICE #5: NOTIFICATION SERVICE (.NET / SignalR)
# ------------------------------------------------------------------------------
NOTIFICATIONS_HTTP_PORT=5005
NOTIFICATIONS_DB_CONNECTION_STRING=Host=postgres;Port=5432;Database=smarthotel_notifications_db;Username=notifications_user;Password=notifications_secure_password_123;

# SignalR Redis Backplane
SIGNALR_REDIS_CONNECTION_STRING=redis:6379,password=redis_secure_password_123,defaultDatabase=1

# External Notification Providers
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_PHONE_NUMBER=+1234567890
FIREBASE_CREDENTIALS_FILE_PATH=/app/secrets/firebase-service-account.json

# ------------------------------------------------------------------------------
# 11. SERVICE #6: AI CONCIERGE SERVICE (Python / FastAPI)
# ------------------------------------------------------------------------------
CONCIERGE_PORT=8000
CONCIERGE_WORKERS=2
CONCIERGE_RELOAD=true

# AI Provider API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
CONCIERGE_DEFAULT_MODEL=gemini-2.0-flash

# Streaming & Context Injection Settings
CONCIERGE_MAX_CONTEXT_TOKENS=8192
CONCIERGE_TEMPERATURE=0.7

# gRPC Client Target Endpoints for Real-Time Context Retrieval
CONCIERGE_HOTELOPS_GRPC_HOST=hotel-ops-service
CONCIERGE_HOTELOPS_GRPC_PORT=6002
CONCIERGE_BOOKING_GRPC_HOST=booking-payments-service
CONCIERGE_BOOKING_GRPC_PORT=6003
