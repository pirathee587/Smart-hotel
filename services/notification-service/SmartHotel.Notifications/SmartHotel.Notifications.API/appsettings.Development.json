{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "DatabaseProvider": "InMemory",
  "DisableRabbitMq": "true",
  "ConnectionStrings": {
    "DefaultConnection": "InMemory"
  },
  "Jwt": {
    "Issuer": "SmartHotel.Identity",
    "Audience": "SmartHotel.Clients",
    "JwksUri": "http://localhost:5001/.well-known/jwks.json"
  }
}
